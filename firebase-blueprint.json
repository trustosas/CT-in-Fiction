{
  "entities": {
    "InviteCode": {
      "title": "InviteCode",
      "description": "Single-use access codes and author keys generated by the Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique Code Key or ID" },
        "code": { "type": "string", "description": "Passcode string" },
        "authorName": { "type": "string", "description": "Author name or alias assigned to this code" },
        "role": { "type": "string", "enum": ["admin", "author"], "description": "Granted role" },
        "isUsed": { "type": "boolean", "description": "Whether code has been redeemed" },
        "usedAt": { "type": "string", "format": "date-time", "description": "Redemption timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "createdBy": { "type": "string", "description": "Admin who generated the code" },
        "notes": { "type": "string", "description": "Optional memo or context" }
      },
      "required": ["id", "code", "authorName", "role", "isUsed", "createdAt"]
    },
    "Author": {
      "title": "Author",
      "description": "Typologist / Analyst who authors character analyses",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Author slug / unique ID" },
        "name": { "type": "string", "description": "Author full name or alias" },
        "avatarUrl": { "type": "string", "description": "Author profile image URL" },
        "bio": { "type": "string", "description": "Short bio or description" },
        "validatedBy": { "type": "string", "description": "Admin or code used to validate this author" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "name"]
    },
    "Work": {
      "title": "Work",
      "description": "Fictional franchise, book, anime, film, or series",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Work slug / unique ID" },
        "title": { "type": "string", "description": "Title of the work" },
        "medium": { "type": "string", "description": "Medium (Anime, Literature, Film, Game, etc.)" },
        "imageUrl": { "type": "string", "description": "Cover art / banner image URL" },
        "description": { "type": "string", "description": "Overview of the fictional universe" },
        "creator": { "type": "string", "description": "Original creator/author of the work" },
        "releaseYear": { "type": "string", "description": "Release year" },
        "isArtOpaque": { "type": "boolean", "description": "Whether artwork uses opaque background" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "title", "medium"]
    },
    "Character": {
      "title": "Character",
      "description": "Character analysis entry adhering to the Cognitive Typology specification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Character slug / unique ID" },
        "name": { "type": "string", "description": "Character name" },
        "imageUrl": { "type": "string", "description": "Portrait image URL" },
        "workId": { "type": "string", "description": "Reference to Work ID" },
        "authorId": { "type": "string", "description": "Reference to Author ID" },
        "type": { "type": "string", "description": "Resolved or partial type code (e.g. TiNe, TiPe, Ji)" },
        "rawQuadra": { "type": "string", "description": "Manually asserted quadra without hierarchy" },
        "dynamic": { "type": "string", "description": "Inter-function dynamic pairing (e.g. Fe+Ne)" },
        "development": { "type": "string", "description": "4-character development state (e.g. I--I)" },
        "emotionalAttitude": { "type": "string", "enum": ["Guarded", "Unguarded", "Neutral"], "description": "Core emotional attitude" },
        "analysis": { "type": "string", "description": "Markdown deep-dive analysis" },
        "notes": { "type": "string", "description": "Internal notes or remarks" },
        "motifValues": { "type": "array", "description": "60-boolean motif checklist values" },
        "motifs": { "type": "array", "description": "Array of active motif index numbers" },
        "isPublished": { "type": "boolean", "description": "Whether the typing is public" },
        "publishedDate": { "type": "string", "description": "Publication date" },
        "editedDate": { "type": "string", "format": "date-time", "description": "Last edit date" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "name", "workId", "authorId", "type"]
    }
  },
  "firestore": {
    "/invite_codes/{codeId}": {
      "schema": "InviteCode",
      "description": "Single-use authorization codes"
    },
    "/authors/{authorId}": {
      "schema": "Author",
      "description": "Typologists and analysts"
    },
    "/works/{workId}": {
      "schema": "Work",
      "description": "Fictional works and universes"
    },
    "/characters/{characterId}": {
      "schema": "Character",
      "description": "Character typings and analyses"
    }
  }
}
