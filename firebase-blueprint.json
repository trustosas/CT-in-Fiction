{
  "entities": {
    "InviteCode": {
      "title": "InviteCode",
      "description": "Single-use access codes and author keys generated by the Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique Code Key or ID" },
        "code": { "type": "string", "description": "Passcode string" },
        "authorName": { "type": "string", "description": "Author name or alias assigned to this code" },
        "role": { "type": "string", "enum": ["admin", "author"], "description": "Granted role" },
        "isUsed": { "type": "boolean", "description": "Whether code has been redeemed" },
        "usedAt": { "type": "string", "format": "date-time", "description": "Redemption timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "createdBy": { "type": "string", "description": "Admin who generated the code" },
        "notes": { "type": "string", "description": "Optional memo or context" }
      },
      "required": ["id", "code", "authorName", "role", "isUsed", "createdAt"]
    },
    "Author": {
      "title": "Author",
      "description": "Typologist / Analyst who authors character analyses (Col 34/AH in Sheet)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Author slug / unique ID" },
        "name": { "type": "string", "description": "Author full name or alias" },
        "avatarUrl": { "type": "string", "description": "Author profile image URL" },
        "bio": { "type": "string", "description": "Short bio or description" },
        "validatedBy": { "type": "string", "description": "Admin or code used to validate this author" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "name"]
    },
    "Work": {
      "title": "Work",
      "description": "Fictional franchise, book, anime, film, or series (Cols 1-4, 33 in Sheet)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Work slug / unique ID" },
        "title": { "type": "string", "description": "Title of the work (Col 2/B)" },
        "medium": { 
          "type": "string", 
          "enum": ["Animation", "Live Action", "Literature", "Comic", "Game"],
          "description": "Medium categorization (Col 1/A)" 
        },
        "releaseYear": { "type": "string", "description": "Release year (Col 3/C)" },
        "imageUrl": { "type": "string", "description": "Cover art / banner image URL (Col 4/D)" },
        "isArtOpaque": { "type": "boolean", "description": "Whether artwork uses opaque background (Col 33/AG)" },
        "creator": { "type": "string", "description": "Original creator/author of the work" },
        "description": { "type": "string", "description": "Overview of the fictional universe" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "title", "medium"]
    },
    "Character": {
      "title": "Character",
      "description": "Character analysis entry adhering to the Cognitive Typology Subject Database Specification (Cols 1-34 + 96 Motif Columns)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Character slug / unique ID" },
        "name": { "type": "string", "description": "Character/Subject Name (Col 5/E)" },
        "imageUrl": { "type": "string", "description": "Subject Image URL (Col 6/F)" },
        "workId": { "type": "string", "description": "Reference to Work ID" },
        "authorId": { "type": "string", "description": "Reference to Author ID" },
        
        "source": { "type": "string", "description": "Denormalized Work Title (Col 2/B)" },
        "medium": { "type": "string", "description": "Denormalized Medium (Col 1/A)" },
        "year": { "type": "string", "description": "Denormalized Release Year (Col 3/C)" },
        "workImageUrl": { "type": "string", "description": "Denormalized Work Cover Art (Col 4/D)" },
        "isWorkArtOpaque": { "type": "boolean", "description": "Denormalized Artwork Opacity Flag (Col 33/AG)" },
        "author": { "type": "string", "description": "Denormalized Author Name (Col 34/AH)" },

        "type": { "type": "string", "description": "Resolved or partial type code (Col 7/G: e.g. TiNe, TiPe, Ji, Je+Pi)" },
        "alternateType": { "type": "string", "description": "Alternate Type hypothesis (Col 8/H)" },
        "dynamic": { "type": "string", "description": "Inter-Function Dynamics (Col 9/I: e.g. Ti+Ne, Fe+Si, Te+Ni, Fe+Se)" },
        "subtype": { "type": "string", "description": "Legacy alias for Dynamic (Col 9/I)" },
        "unguardedness": { "type": "string", "enum": ["Low", "Medium", "High"], "description": "Unguardedness level (Col 10/J)" },
        "guardedness": { "type": "string", "enum": ["Low", "Medium", "High"], "description": "Guardedness level (Col 11/K)" },
        "emotionalAttitude": { "type": "string", "enum": ["Guarded", "Unguarded", "Neutral"], "description": "Synthesized Emotional Attitude" },
        
        "quadra": { "type": "string", "description": "Formula-derived Quadra (Col 21/U: Alpha, Beta, Gamma, Delta)" },
        "rawQuadra": { "type": "string", "description": "Raw Asserted Quadra fallback (Col 25/Y)" },
        
        "initialDevelopment": { "type": "string", "description": "Initial Development code (Col 26/Z: e.g. I---, II--, I-I-)" },
        "finalDevelopment": { "type": "string", "description": "Final Development code (Col 27/AA: e.g. I-I-, III-, IIII)" },
        "development": { "type": "string", "description": "Active Development Code" },

        "analysis": { "type": "string", "description": "Scoped Analysis Path (Col 28/AB: {Author}/{Work} ({Year})/{Subject}.md)" },
        "notes": { "type": "string", "description": "Internal notes / character remarks (Col 29/AC)" },

        "isPublished": { "type": "boolean", "description": "Publish status checkbox (Col 30/AD)" },
        "publishedDate": { "type": "string", "description": "Publication timestamp (Col 31/AE)" },
        "editedDate": { "type": "string", "description": "Last edit timestamp (Col 32/AF)" },

        "motifValues": { 
          "type": "array", 
          "description": "96-column boolean matrix across 12 functions (Je, Pi, Pe, Ji, Fe, Te, Ni, Si, Ti, Fi, Se, Ne) x 8 traits (Philosophical 1-3, Behavioural 1-3, Linguistic 1-2)" 
        },
        "motifs": { "type": "array", "description": "Array of active motif index numbers" },

        "leadEnergetic": { "type": "string", "description": "Computed Lead Energetic (Ji, Je, Pi, Pe)" },
        "auxiliaryEnergetic": { "type": "string", "description": "Computed Aux Energetic (Ji, Je, Pi, Pe)" },
        "tertiaryEnergetic": { "type": "string", "description": "Computed Tertiary Energetic (Ji, Je, Pi, Pe)" },
        "polarEnergetic": { "type": "string", "description": "Computed Polar Energetic (Ji, Je, Pi, Pe)" },
        "leadFunction": { "type": "string", "description": "Computed Lead Function (Ti, Te, Fi, Fe, Ni, Ne, Si, Se)" },
        "auxiliaryFunction": { "type": "string", "description": "Computed Aux Function" },
        "tertiaryFunction": { "type": "string", "description": "Computed Tertiary Function" },
        "polarFunction": { "type": "string", "description": "Computed Polar Function" },
        "judgmentAxis": { "type": "string", "description": "Computed Judgment Axis (Ti/Fe, Fi/Te)" },
        "perceptionAxis": { "type": "string", "description": "Computed Perception Axis (Ne/Si, Se/Ni)" },

        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "name", "workId", "type"]
    }
  },
  "firestore": {
    "/invite_codes/{codeId}": {
      "schema": "InviteCode",
      "description": "Single-use authorization codes"
    },
    "/authors/{authorId}": {
      "schema": "Author",
      "description": "Typologists and analysts"
    },
    "/works/{workId}": {
      "schema": "Work",
      "description": "Fictional works and universes"
    },
    "/characters/{characterId}": {
      "schema": "Character",
      "description": "Character typings and analyses"
    }
  }
}
