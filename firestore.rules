rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Invite Codes (Single-use codes for Author & Admin authorization)
    match /invite_codes/{codeId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 2. Authors (Validated community typologists)
    match /authors/{authorId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 3. Works (Franchises / Universes)
    match /works/{workId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 4. Characters (Cognitive Typology Profiles & Analyses)
    match /characters/{characterId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
